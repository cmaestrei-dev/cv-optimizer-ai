# Postgres (Neon). Sin esto, en local se usa data/cv_core.db
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.neon.tech/neondb?sslmode=require

# Gemini API
GEMINI_API_KEY=your_api_key_here

# Optional: Override default model
GEMINI_MODEL=gemini-3.5-flash-lite

# Motor nuevo (core/): proveedor y modelo por tarea, formato 'proveedor' o 'proveedor:modelo'.
# Proveedores: gemini, deepseek. Por defecto: gemini con GEMINI_MODEL.
# LLM_EXTRACT=gemini
# LLM_WRITE=deepseek:deepseek-flash
# DEEPSEEK_API_KEY=your_deepseek_key_here

# API del SaaS (fase 5, `uvicorn api.main:app`). Producción: tokens del proveedor de identidad.
# AUTH_JWKS_URL=https://tu-proveedor/.well-known/jwks.json
# AUTH_ISSUER=https://tu-proveedor
# AUTH_AUDIENCE=
# Desarrollo local (solo con SQLite; 32+ caracteres). Token: python scripts/dev_token.py ana
# AUTH_DEV_SECRET=
# Orígenes del frontend, separados por comas
# API_CORS_ORIGINS=http://localhost:5173
